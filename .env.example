# Database connection (PostgreSQL)
# For local development: postgresql://postgres:postgres@localhost:5432/go_api_starter?sslmode=disable
# For Docker: postgresql://postgres:postgres@localhost:5434/go_api_starter?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/go_api_starter?sslmode=disable

# JWT Secret (generate with: openssl rand -base64 32)
# IMPORTANT: Change this in production! Never use the default in production.
JWT_SECRET=dev-secret-change-in-production

# Optional: API Access Token for service-to-service authentication
# If set, requests with X-API-Token header matching this value will bypass JWT auth
# API_ACCESS_TOKEN=your-service-token-here

# Server configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info

# Test database (for running tests)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/go_api_starter_test?sslmode=disable

# Rate Limiting (enabled by default)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SEC=10.0
RATE_LIMIT_BURST=20
